{
  "name": "noai",
  "version": "0.1.0",
  "private": true,
  "description": "A Chrome extension for blocking AI slop on the internet.",
  "type": "module",
  "scripts": {
    "build": "pnpm build:extension && pnpm build:api && pnpm build:web",
    "build:api": "pnpm --filter @noai/api build",
    "build:extension": "tsc --noEmit && vite build",
    "build:web": "pnpm --filter @noai/web build",
    "check": "biome check . && tsc --noEmit && pnpm --filter @noai/api typecheck && pnpm --filter @noai/web typecheck",
    "check:fix": "biome check --write .",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^5.0.0"
  }
}
